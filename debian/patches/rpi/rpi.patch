+static inline bool pio_calculate_clkdiv_from_fp24_8(struct fp24_8 div, uint16_t *div_int,
+						   uint8_t *div_frac)
+{
+	uint inum = (div.val >> 8);
+
+	if (bad_params_if(NULL, inum < 1 || inum > 65536))
+		return false;
+	*div_int = (uint16_t)inum;
+	if (*div_int == 0)
+		*div_frac = 0;
+	else
+		*div_frac = div.val & 0xff;
+	return true;
+}
