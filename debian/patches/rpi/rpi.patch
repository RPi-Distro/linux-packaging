+				interrupts = <24 IRQ_TYPE_EDGE_FALLING>;
+				pinctrl-0 = <&sc16is75x_pins>;
+				pinctrl-names = "default";
+				gpio-controller;
+				#gpio-cells = <2>;
+				spi-max-frequency = <4000000>;
+			};
+		};
+	};
+
+	fragment@2 {
+		target-path = "/";
+		__overlay__ {
+			sc16is75x_clk: sc16is75x_clk {
