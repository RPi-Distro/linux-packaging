#!/bin/sh -e

skip_initramfs_gen ()
(
    if [ -r /etc/default/raspi-firmware ]; then
        . /etc/default/raspi-firmware
    fi
    if [ "$(echo "$SKIP_INITRAMFS_GEN" | tr '[:upper:]' '[:lower:]' | sed 's/true\|1/yes/')" = 'yes' ]; then
        return 0
    fi
    return 1
)

version=@abiname@@localversion@
image_path=/boot/@image-stem@-$version

if [ "$1" != configure ]; then
    exit 0
fi

depmod $version

if [ -f /lib/modules/$version/.fresh-install ]; then
    change=install
else
    change=upgrade
fi
linux-update-symlinks $change $version $image_path
rm -f /lib/modules/$version/.fresh-install

if skip_initramfs_gen; then
    export INITRD=No
fi
linux-run-hooks image postinst $version $image_path -- "$@"

exit 0
